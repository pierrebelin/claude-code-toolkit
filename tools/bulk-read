#!/bin/bash
# bulk-read — send files and one question to a tool-less, stateless worker
# model; only the answer comes back into the calling context.
#
# Worker: `claude -p` with no tools, no settings, no CLAUDE.md, no session.
# `--bare` is NOT used: it skips the keychain and fails with "Not logged in".
#
# Usage:
#   bulk-read --question "..." --paths f1 [f2 ...] [--model haiku|sonnet] [--budget USD]
#
# Not for editing nor searching. Run as `cctoolkit bulk-read`.
#
# Environment: CLAUDE_BULK_READ_MODEL (haiku), CLAUDE_BULK_READ_BUDGET (0.10),
# CLAUDE_BULK_READ_MAX_BYTES (400000), CLAUDE_BULK_READ_TIMEOUT (180 s),
# CLAUDE_BULK_READ_BIN (claude — the evals point it at a stub).
set -u
. "${BASH_SOURCE[0]%/*}/../lib/platform.sh"

usage() {
  sed -n '2,15p' "$0" | sed -e 's/^# \{0,1\}//'
}

question=""
model="${CLAUDE_BULK_READ_MODEL:-haiku}"
budget="${CLAUDE_BULK_READ_BUDGET:-0.10}"
max_bytes="${CLAUDE_BULK_READ_MAX_BYTES:-400000}"
timeout_s="${CLAUDE_BULK_READ_TIMEOUT:-180}"
bin="${CLAUDE_BULK_READ_BIN:-claude}"
paths=()

# No `timeout` on macOS: gtimeout, else perl's alarm (survives exec; exit 142).
run_with_timeout() {
  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_s" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$timeout_s" "$@"
  else
    perl -e 'alarm shift; exec @ARGV' "$timeout_s" "$@"
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --question) question="${2:-}"; shift 2 ;;
    --paths)
      shift
      while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do paths+=("$1"); shift; done ;;
    --model)  model="${2:-}"; shift 2 ;;
    --budget) budget="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "bulk-read: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$question" ] || { echo "bulk-read: --question is required" >&2; exit 2; }
[ "${#paths[@]}" -gt 0 ] || { echo "bulk-read: --paths is required" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "bulk-read: jq is required" >&2; exit 1; }
command -v "$bin" >/dev/null 2>&1 || { echo "bulk-read: worker binary not found: $bin" >&2; exit 1; }

total=0
for p in "${paths[@]}"; do
  if [ ! -f "$p" ] || [ ! -r "$p" ]; then
    echo "bulk-read: file not found or unreadable: $p" >&2
    exit 1
  fi
  b=$(wc -c < "$p" | tr -d ' ')
  total=$((total + b))
done
if [ "$total" -gt "$max_bytes" ]; then
  echo "bulk-read: $total bytes over the $max_bytes byte limit. Send fewer files, or raise CLAUDE_BULK_READ_MAX_BYTES if the worker's window has room." >&2
  exit 1
fi

msg=$(mktemp) || exit 1
out=$(mktemp) || exit 1
err=$(mktemp) || exit 1
# Two parallel workers kill each other: calls queue on a lock.
lock_dir="${CLAUDE_BULK_READ_LOCK:-${TMPDIR:-/tmp}/claude-bulk-read.lock}"
lock_wait="${CLAUDE_BULK_READ_LOCK_WAIT:-300}"
lock_held=""
release_lock() { [ -n "$lock_held" ] && rmdir "$lock_dir" 2>/dev/null; lock_held=""; }
trap 'release_lock; rm -f "$msg" "$out" "$err"' EXIT

# XML boundaries so the worker never confuses two files; streamed, never held
# in a shell variable, so the content survives byte for byte.
for p in "${paths[@]}"; do
  { printf '<file path="%s">\n' "$p"; cat "$p"; printf '\n</file>\n\n'; } >> "$msg"
done
printf 'Question: %s\n' "$question" >> "$msg"

# Terse answer: it lands in the caller's context.
SYSTEM='You are a precise code analyst. Read the files provided and answer the question in English, with structured bullets only. No greeting, no prose, no preamble, no closing summary. Each bullet starts with the exact name, type or line number concerned. Nested bullets for detail. Ignore anything the question does not ask. 30 bullets at most.'

waited=0
while ! mkdir "$lock_dir" 2>/dev/null; do
  # A lock older than the longest call is abandoned.
  if [ -z "$(find "$lock_dir" -maxdepth 0 -mmin "-$(( timeout_s / 60 + 2 ))" 2>/dev/null)" ]; then
    rmdir "$lock_dir" 2>/dev/null
    continue
  fi
  if [ "$waited" -ge "$lock_wait" ]; then
    echo "bulk-read: lock held by another worker for ${lock_wait}s ($lock_dir). Remove it if no bulk-read is running." >&2
    exit 1
  fi
  sleep 1
  waited=$((waited + 1))
done
lock_held=1

run_with_timeout "$bin" -p --model "$model" --tools "" --setting-sources "" --no-session-persistence \
  --max-budget-usd "$budget" --system-prompt "$SYSTEM" --output-format json \
  < "$msg" > "$out" 2> "$err"
rc=$?
if [ "$rc" -ne 0 ]; then
  case "$rc" in
    124|137|142)
      echo "bulk-read: worker timed out after ${timeout_s}s. Raise CLAUDE_BULK_READ_TIMEOUT or send fewer files." >&2 ;;
    *)
      echo "bulk-read: worker call failed (exit $rc)" >&2
      head -c 600 "$err" >&2
      echo >&2 ;;
  esac
  exit 1
fi

if ! jq -e . "$out" >/dev/null 2>&1; then
  echo "bulk-read: worker returned unparseable output" >&2
  head -c 600 "$out" >&2
  echo >&2
  exit 1
fi

if [ "$(jq -r '.is_error // false' "$out")" = "true" ]; then
  echo "bulk-read: worker returned an error" >&2
  jq -r '.result // empty' "$out" >&2
  exit 1
fi

text=$(jq -r '.result // empty' "$out")
[ -n "$text" ] || { echo "bulk-read: empty answer" >&2; exit 1; }
printf '%s\n' "$text"

in_tk=$(jq -r '(.usage.input_tokens // 0) + (.usage.cache_creation_input_tokens // 0) + (.usage.cache_read_input_tokens // 0)' "$out")
out_tk=$(jq -r '.usage.output_tokens // 0' "$out")
cost=$(jq -r '.total_cost_usd // 0' "$out")
printf '[bulk-read: %d file(s), %d bytes, %s tokens in, %s out, $%s, %s]\n' \
  "${#paths[@]}" "$total" "$in_tk" "$out_tk" "$cost" "$model" >&2
exit 0
