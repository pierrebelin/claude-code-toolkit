#!/bin/bash
# doctor — read-only readiness check of the Claude Code setup in this repo.
#
# Why. The setup has at least six failure modes that make no visible error: the
# guard simply does not fire, and the miss shows up on the bill. Each was found
# after the fact and documented somewhere in a comment — this puts them in one
# place, checked in a second. Shape borrowed from Spotify's portal plugin
# (`skills/doctor`: "Keep doctor read-only"). It observes, never repairs: every
# line that is not `ok` names the command that would.
#
# Usage:
#   cctoolkit doctor            # every check, one line each
#   cctoolkit doctor --quiet    # only WARN, FAIL and NOTE lines (SessionStart hook)
#   cctoolkit doctor --evals    # also run the kit's evals/run.sh and report its summary
#
# The repo is the one lib/project-root.sh resolves ($CLAUDE_PROJECT_DIR, else the
# git top level); CLAUDE_DOCTOR_ROOT overrides it (evals).
#
# Exit 1 when any check FAILs, 0 otherwise. The SessionStart registration appends
# `|| true`: a doctor must never block a session, only report.
set -u

QUIET=0
EVALS=0
for a in "$@"; do
  case "$a" in
    --quiet|-q) QUIET=1 ;;
    --evals) EVALS=1 ;;
    -h|--help) sed -n '2,22p' "$0" | sed -e 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "doctor: unknown argument: $a" >&2; exit 2 ;;
  esac
done

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../lib/project-root.sh"
# KIT_DIR: the plugin (cache directory) or the toolkit checkout. ROOT: the repo.
ROOT="${CLAUDE_DOCTOR_ROOT:-$PROJECT_ROOT}"
CL="$ROOT/.claude"
KIT="$KIT_DIR"
FAILS=0
WARNS=0

report() { # level name detail
  local level=$1 name=$2 detail=${3:-}
  case "$level" in
    FAIL) FAILS=$((FAILS + 1)) ;;
    WARN) WARNS=$((WARNS + 1)) ;;
    ok) [ "$QUIET" -eq 1 ] && return ;;
    # A reminder, not a defect: printed even with --quiet, counted nowhere.
    NOTE) ;;
  esac
  if [ -n "$detail" ]; then
    printf '%-4s %-28s %s\n' "$level" "$name" "$detail"
  else
    printf '%-4s %s\n' "$level" "$name"
  fi
}

# --- binaries ------------------------------------------------------------------
for bin in bash jq python3 perl; do
  command -v "$bin" >/dev/null 2>&1 && report ok "binary $bin" || report FAIL "binary $bin" "required by the hooks"
done
if command -v rtk >/dev/null 2>&1; then
  v=$(rtk --version 2>/dev/null | head -1)
  case "$v" in
    rtk\ [0-9]*)
      if rtk gain >/dev/null 2>&1; then report ok "rtk" "$v"
      else report FAIL "rtk" "$v answers --version but 'rtk gain' fails — name collision with another rtk on PATH? (which -a rtk)"; fi ;;
    *) report FAIL "rtk" "'rtk --version' printed '${v:-nothing}' — not Rust Token Killer (which -a rtk)" ;;
  esac
else
  report FAIL "rtk" "not on PATH — rewrite-rtk.sh has nothing to call"
fi
command -v graphify >/dev/null 2>&1 && report ok "binary graphify" "$(command -v graphify)" || report FAIL "binary graphify" "not on PATH — affected-blast-radius and the autosync are dead (docs/TOOLING.md of the kit)"
command -v claude >/dev/null 2>&1 && report ok "binary claude" "$(claude --version 2>/dev/null | head -1)" || report WARN "binary claude" "not on PATH — bulk-read cannot run"
command -v ast-grep >/dev/null 2>&1 || command -v sg >/dev/null 2>&1 && report ok "binary ast-grep" || report WARN "binary ast-grep" "cctoolkit access-cost exits 3, COUT stated by hand; structural search unavailable (brew install ast-grep)"

# --- plugin registration and hook wiring ----------------------------------------
# The hooks ship in the plugin (hooks/hooks.json, paths under ${CLAUDE_PLUGIN_ROOT});
# what the repo carries is the plugin's enablement in a settings file. Committed in
# .claude/settings.json it reaches every clone and worktree; in settings.local.json
# only this checkout (a worktree then needs scripts/install-git-hooks.sh).
local_hooks=0
enabled_in=""
for f in "$CL/settings.json" "$CL/settings.local.json" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"; do
  [ -e "$f" ] || continue
  name=${f/#$ROOT\//}; name=${name/#$HOME/\~}
  if [ -L "$f" ] && [ ! -f "$f" ]; then
    report FAIL "$name" "dead symlink → $(readlink "$f")"; continue
  fi
  if ! jq -e . "$f" >/dev/null 2>&1; then
    report FAIL "$name" "invalid JSON — every setting it carries is lost"; continue
  fi
  if jq -e '[.enabledPlugins // {} | to_entries[] | select((.key | startswith("cctoolkit@")) and .value == true)] | length > 0' "$f" >/dev/null 2>&1; then
    enabled_in="$enabled_in $name"
    [ "$f" = "$CL/settings.local.json" ] && local_hooks=1
  fi
  # A copy installed before the plugin registered its hooks here, by path. Left in
  # place next to the plugin, every guard fires twice — README § Migrating.
  legacy=$(jq -r '.hooks // {} | to_entries[] | .value[] | .hooks[]? | .command // empty' "$f" 2>/dev/null | grep -c '\.claude/hooks/')
  [ "${legacy:-0}" -gt 0 ] && report WARN "legacy hook wiring" "$name registers $legacy command(s) under .claude/hooks/ — remove its \"hooks\" key (README § Migrating)"
done
if [ -n "$enabled_in" ]; then
  report ok "plugin enabled" "cctoolkit in${enabled_in}"
  case "$enabled_in" in *settings.json*) local_hooks=0 ;; esac
else
  report FAIL "plugin enabled" "cctoolkit is not enabled for $ROOT — no kit hook fires here (README § Installation)"
fi
HJ="$KIT/hooks/hooks.json"
if [ ! -f "$HJ" ]; then
  report FAIL "hooks/hooks.json" "absent from the kit at $KIT"
elif ! jq -e . "$HJ" >/dev/null 2>&1; then
  report FAIL "hooks/hooks.json" "invalid JSON — not one kit hook fires"
else
  commands=$(jq -r '.hooks | to_entries[] | .value[] | .hooks[]? | .command // empty' "$HJ")
  missing=0
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    script=$(printf '%s' "$c" | sed -n 's/^bash \([^ ]*\).*/\1/p' | tr -d '"')
    [ -n "$script" ] || continue
    script=${script//\$\{CLAUDE_PLUGIN_ROOT\}/$KIT}
    [ -f "$script" ] || { report FAIL "hook registered, script gone" "$c"; missing=$((missing + 1)); }
  done <<EOF
$commands
EOF
  [ "$missing" -eq 0 ] && report ok "hook registrations" "$(printf '%s\n' "$commands" | grep -c .) commands in hooks/hooks.json, every script present"
  for sh in "$KIT"/hooks/*.sh; do
    b=$(basename "$sh")
    printf '%s' "$commands" | grep -q "$b" || report WARN "hook script not registered" "$b — never fires (dead hook, or add it to hooks/hooks.json)"
  done
fi
# A copy predating the plugin: its skills and agents load beside the plugin's, under
# their bare names, and they read the copy's hooks and scripts — two kits in one session.
if [ "$ROOT" != "$KIT" ]; then
  # One probe per folder; lib/guard-git.sh predates kit_config.py, so older copies show too.
  # skills/implement-tdd/SKILL.md, not the folder: a repo file kept there (a reference its
  # own skill reads) is no skill, so no copy.
  for p in hooks/bash-dispatch.sh lib/guard-git.sh skills/implement-tdd/SKILL.md agents/tdd-implementer.md tools/doctor presets evals/run.sh scripts/pre-audit.sh; do
    [ -e "$CL/$p" ] && report WARN "legacy copy" ".claude/${p%%/*}/ from a manual install — delete it once the plugin is enabled (README § Migrating)"
  done
  [ -f "$ROOT/scripts/pre-audit.sh" ] \
    && report WARN "legacy copy" "scripts/ holds the kit's scripts from a manual install — delete them (README § Migrating)"
  # The mods once shipped as their own marketplace inside the copy; the plugin's
  # marketplace carries them now, and both enabled draw every band and pane twice.
  [ -f "$CL/mods/.claude-plugin/marketplace.json" ] \
    && report WARN "legacy mods" ".claude/mods/ is a marketplace from a manual install — delete it, enable the mods as <mod>@cctoolkit (README § Migrating)"
fi

# --- repo-owned files ------------------------------------------------------------
# What a plugin cannot ship: the rules (no plugin component loads them) and the
# config. /cctoolkit:kit-init writes both.
if [ -f "$CL/rules/markdown-output.md" ]; then
  report ok "rules" "$(ls "$CL"/rules/*.md 2>/dev/null | wc -l | tr -d ' ') file(s) in .claude/rules/"
  # A copy's version predates the anchors: it teaches literals no parser reads any more.
  grep -q 'kit:rules' "$CL/rules/markdown-output.md" \
    || report WARN "rules outdated" ".claude/rules/markdown-output.md predates the <!-- kit:… --> anchors — its frozen literals are no longer the parsers' (replace it: /cctoolkit:kit-init)"
else
  report FAIL "rules" ".claude/rules/markdown-output.md absent — the skills cite it on every document (/cctoolkit:kit-init)"
fi
# Instructions still pointing into a removed copy: the model runs a path that is gone.
if [ "$ROOT" != "$KIT" ]; then
  # The template statusline keeps .claude/lib/ as a fallback behind the plugin cache.
  sl="$CL/statusline-command.sh"; grep -q 'plugins/cache' "$sl" 2>/dev/null && sl=
  # A folder cited alone ("after editing .claude/hooks") is stale too once it is gone.
  stale=$(grep -oE '\.claude/(hooks|lib|scripts|tools|evals)(/[A-Za-z0-9_.-]+)?' "$ROOT/CLAUDE.md" "$CL"/rules/*.md ${sl:+"$sl"} 2>/dev/null \
    | while IFS=: read -r f ref; do [ -e "$ROOT/$ref" ] || echo "${f#"$ROOT"/}"; done | sort | uniq -c | awk '{printf "%s%s (%s)", sep, $2, $1; sep=", "}')
  [ -n "$stale" ] && report WARN "stale kit paths" "$stale — paths of a removed copy: \`cctoolkit <name>\` replaces scripts and tools, the plugin the rest"
fi

# --- dispatcher modules --------------------------------------------------------
if [ -f "$KIT/hooks/bash-dispatch.sh" ]; then
  mods=$(sed -n '/^MODULES=(/,/^)/p' "$KIT/hooks/bash-dispatch.sh" | grep -o '"[^"]*"' | tr -d '"' | awk '{print $1}')
  bad=0
  for m in $mods; do
    [ -f "$KIT/lib/$m" ] || { report FAIL "dispatch module" "$m listed in bash-dispatch.sh, missing in lib/"; bad=1; }
  done
  [ "$bad" -eq 0 ] && report ok "dispatch modules" "$(printf '%s\n' "$mods" | grep -c .) present"
fi

# --- worktree wiring -----------------------------------------------------------
if git -C "$ROOT" rev-parse --show-toplevel >/dev/null 2>&1; then
  common=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null)
  case "$common" in /*) ;; *) common="$ROOT/$common" ;; esac
  pc="$common/hooks/post-checkout"
  if [ "$local_hooks" -eq 0 ]; then
    report ok "git post-checkout hook" "not needed — the plugin enabled in the committed settings.json reaches every worktree"
  elif [ -f "$pc" ] && grep -q 'settings.local.json' "$pc" 2>/dev/null; then
    report ok "git post-checkout hook" "links settings.local.json into new worktrees"
  else
    report FAIL "git post-checkout hook" "absent — a new worktree runs unguarded (cctoolkit install-git-hooks)"
  fi
  main=$(git -C "$ROOT" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  here=$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$main" ] && [ "$here" != "$main" ]; then
    { [ "$local_hooks" -eq 0 ] || [ -L "$SETTINGS" ]; } && report ok "worktree" "$here, hooks reach it from $main" \
      || report WARN "worktree" "$here has its own settings.local.json — edits here never reach $main"
  fi
else
  report WARN "git" "$ROOT is not a git checkout"
fi

# --- graphify graph ------------------------------------------------------------
GRAPH="$ROOT/graphify-out/graph.json"
if [ -f "$GRAPH" ]; then
  if [ -f "$KIT/lib/graphify-freshness.sh" ]; then
    lag=$(GRAPHIFY_REPO="$ROOT" bash "$KIT/lib/graphify-freshness.sh" --count 2>/dev/null)
    case "$lag" in
      0) report ok "graphify graph" "up to date ($(date -r "$GRAPH" '+%Y-%m-%d %H:%M'))" ;;
      ''|*[!0-9]*) report WARN "graphify graph" "freshness unknown" ;;
      *) report WARN "graphify graph" "$lag source(s) newer than graph.json — the Stop hook resyncs, or graphify update ." ;;
    esac
  fi
  log=/tmp/graphify-hook.log
  if [ -f "$log" ] && tail -5 "$log" 2>/dev/null | grep -q 'ALERT update refused'; then
    report WARN "graphify autosync" "last run refused to overwrite a shrunken graph — graphify update . --force after a deleting refactor"
  fi
else
  report FAIL "graphify graph" "graphify-out/graph.json absent — graphify update . (docs/TOOLING.md of the kit)"
fi

# --- worker login --------------------------------------------------------------
if command -v claude >/dev/null 2>&1; then
  case "$(uname -s)" in
    Darwin)
      security find-generic-password -s 'Claude Code-credentials' >/dev/null 2>&1 \
        && report ok "claude login" "keychain entry present (bulk-read can run)" \
        || report WARN "claude login" "no keychain entry — bulk-read will answer 'Not logged in' (claude /login)" ;;
    *)
      [ -f "$HOME/.claude/.credentials.json" ] \
        && report ok "claude login" "credentials file present" \
        || report WARN "claude login" "no credentials file — bulk-read will answer 'Not logged in'" ;;
  esac
fi

# --- tools, evals ---------------------------------------------------------------
for t in "$KIT"/tools/* "$KIT"/bin/* "$KIT"/evals/run.sh; do
  [ -f "$t" ] || continue
  case "$t" in *.md) continue ;; esac
  [ -x "$t" ] && report ok "executable $(basename "$t")" || report WARN "executable $(basename "$t")" "missing +x (chmod +x $t)"
done

# --- kit.config.json --------------------------------------------------------------
# The hooks read it through lib/kit_config.py and go silent on any defect — a
# broken file, an unknown preset, a layout matching no directory. That silence is
# exactly a doctor's case. rules/*.md is the repo's own: never parsed here.
if out=$(python3 "$KIT/lib/kit_config.py" validate "$ROOT" 2>&1); then
  while IFS=$'\t' read -r level name detail; do
    [ -n "$level" ] && report "$level" "$name" "$detail"
  done <<KITEOF
$out
KITEOF
else
  report FAIL "kit.config.json" "validation crashed: $(printf '%s' "$out" | tail -1)"
fi

# --- /tmp leftovers ------------------------------------------------------------
# session-cleanup.sh purges at `-mtime +2`, and BSD find counts whole 24 h
# periods: a file 71 h old at SessionStart survives, and would trip a `+2` here
# an hour later. `+3` only reports what a cleanup actually missed.
orphans=$(find -H /tmp -maxdepth 1 -name 'claude-*' -mtime +3 2>/dev/null | wc -l | tr -d ' ')
[ "${orphans:-0}" -eq 0 ] && report ok "/tmp state" "nothing older than 3 days" \
  || report WARN "/tmp state" "$orphans claude-* file(s) older than 3 days survived session-cleanup.sh — check its PREFIXES list"

# --- /learn backlog -------------------------------------------------------------
# Verdict deviations nobody turned into a rule yet. The script only refreshes its
# own transcript cache (.claude/learn-state.json, ignored by git): nothing in the
# repo changes. Silent below two lots, so a single bad batch does not nag.
if [ -f "$KIT/scripts/learn-candidates.py" ]; then
  backlog=$(CLAUDE_PROJECT_DIR="$ROOT" python3 "$KIT/scripts/learn-candidates.py" --count 2>/dev/null)
  [ -n "$backlog" ] && report NOTE "learn" "$backlog"
fi

# --- evals on demand -----------------------------------------------------------
if [ "$EVALS" -eq 1 ] && [ -f "$KIT/evals/run.sh" ]; then
  summary=$(bash "$KIT/evals/run.sh" 2>&1 | tail -1)
  case "$summary" in
    *", 0 failed") report ok "hook evals" "$summary" ;;
    *) report FAIL "hook evals" "$summary — cctoolkit evals for the detail" ;;
  esac
fi

if [ "$QUIET" -eq 0 ] || [ "$FAILS" -gt 0 ] || [ "$WARNS" -gt 0 ]; then
  printf '%s\n' "doctor: $FAILS FAIL, $WARNS WARN"
fi
[ "$FAILS" -eq 0 ]
