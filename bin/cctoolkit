#!/bin/bash
# cctoolkit — one entry point for the kit's scripts and tools (plugin bin/ is on PATH).
#
# Usage:
#   cctoolkit <script> [args]   scripts/<script>.sh or scripts/<script>.py
#   cctoolkit doctor [args]     tools/doctor
#   cctoolkit bulk-read [args]  tools/bulk-read
#   cctoolkit context-report    lib/context-report.sh
#   cctoolkit config <cmd>      lib/kit_config.py: validate, command, root
#   cctoolkit evals [args]      evals/run.sh
#   cctoolkit root              the kit directory (plugin cache or toolkit checkout)
#   cctoolkit list              every command
#
# Run it from inside the repo: $CLAUDE_PROJECT_DIR, else the git top level.
set -u
. "${BASH_SOURCE[0]%/*}/../lib/platform.sh"
KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

list() {
  printf '%s\n' doctor bulk-read context-report config evals root
  for f in "$KIT"/scripts/*.sh "$KIT"/scripts/*.py; do
    [ -f "$f" ] || continue
    b=$(basename "$f"); printf '%s\n' "${b%.*}"
  done | sort -u
}

cmd="${1:-}"
[ -n "$cmd" ] || { sed -n '2,14p' "$0" | sed -e 's/^# \{0,1\}//'; exit 2; }
shift
case "$cmd" in
  -h|--help) sed -n '2,14p' "$0" | sed -e 's/^# \{0,1\}//'; exit 0 ;;
  root) printf '%s\n' "$KIT"; exit 0 ;;
  list) list; exit 0 ;;
  doctor|bulk-read) exec bash "$KIT/tools/$cmd" "$@" ;;
  context-report) exec bash "$KIT/lib/context-report.sh" "$@" ;;
  config) exec "${CCTOOLKIT_PYTHON:-python3}" "$KIT/lib/kit_config.py" "$@" ;;
  evals) exec bash "$KIT/evals/run.sh" "$@" ;;
esac
case "$cmd" in
  */*|.*) echo "cctoolkit: invalid command '$cmd'" >&2; exit 2 ;;
esac
[ -f "$KIT/scripts/$cmd.sh" ] && exec bash "$KIT/scripts/$cmd.sh" "$@"
[ -f "$KIT/scripts/$cmd.py" ] && exec "${CCTOOLKIT_PYTHON:-python3}" "$KIT/scripts/$cmd.py" "$@"
echo "cctoolkit: unknown command '$cmd' — cctoolkit list" >&2
exit 2
