{
  "description": "One folder per feature holding command, handler, endpoint and its unit tests; the domain model in a shared folder. Stack-neutral markers: C#, Python, Java/Kotlin, TypeScript, Rust.",
  "layout": {
    "sources": {
      "roots": [
        "src"
      ],
      "extensions": [
        ".cs",
        ".py",
        ".java",
        ".kt",
        ".ts",
        ".tsx",
        ".js",
        ".rs"
      ],
      "comment": {
        ".cs": "//",
        ".py": "#",
        ".java": "//",
        ".kt": "//",
        ".ts": "//",
        ".tsx": "//",
        ".js": "//",
        ".rs": "//"
      },
      "imports": {
        ".cs": "^\\s*(?:global\\s+)?using\\s+(?:static\\s+)?[\\w.]+(?:\\s*=\\s*[\\w.<>, ]+)?\\s*;\\s*$",
        ".py": "^\\s*(?:import\\s+[\\w.]+|from\\s+[\\w.]+\\s+import\\s)",
        ".java": "^\\s*import\\s+(?:static\\s+)?[\\w.*]+\\s*;\\s*$",
        ".kt": "^\\s*import\\s+[\\w.*]+(?:\\s+as\\s+\\w+)?\\s*$",
        ".ts": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]",
        ".tsx": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]",
        ".js": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]|^\\s*(?:const|let|var)\\s+[\\w{}\\s,]+=\\s*require\\(",
        ".rs": "^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?(?:use\\s+[\\w:{}*, ]+;|use\\s+[\\w:]+::\\{|mod\\s+\\w+\\s*;|extern\\s+crate\\s+[\\w ]+;)\\s*$"
      }
    },
    "aggregate": [
      "*/src/*/Domain/*",
      "*/src/*/domain/*",
      "*/src/Domain/*",
      "*/src/domain/*"
    ],
    "useCase": {
      "roots": [
        "src/{product}/Features",
        "src/Features",
        "src/features"
      ],
      "contextDepth": 1,
      "label": "the feature slices",
      "marker": [
        {
          "file": "*Handler.cs",
          "contains": "\\bclass\\s+\\w*Handler\\b"
        },
        {
          "file": "*handler.py",
          "contains": "^\\s*(?:async\\s+)?def\\s+handle\\b|^class\\s+\\w*Handler\\b"
        },
        {
          "file": "*Handler.java",
          "contains": "\\bclass\\s+\\w*Handler\\b"
        },
        {
          "file": "*Handler.kt",
          "contains": "\\bclass\\s+\\w*Handler\\b"
        },
        {
          "file": "*[hH]andler.ts",
          "contains": "\\bclass\\s+\\w*Handler\\b|\\bfunction\\s+handle\\w*\\b|\\bconst\\s+handle\\w*\\s*="
        },
        {
          "file": "*handler.rs",
          "contains": "^\\s*pub\\s+(?:async\\s+)?fn\\s+handle\\w*\\b"
        }
      ]
    },
    "ruleSheet": "CLAUDE.md",
    "tests": {
      "roots": [
        "src/{product}/Features",
        "src/Features",
        "src/features",
        "tests"
      ],
      "bound": [
        "src/{product}/Features",
        "src/Features",
        "src/features"
      ],
      "interaction": [
        "src/{product}/Features",
        "src/Features",
        "src/features"
      ]
    },
    "skipDirs": [
      "bin",
      "obj",
      "node_modules",
      "__pycache__",
      ".venv",
      "venv",
      "dist",
      "build",
      "target",
      ".pytest_cache"
    ]
  },
  "testTag": {
    "framework": "xunit"
  },
  "commands": {
    "build": "",
    "test": "",
    "worktreeSetup": "",
    "architectureTest": {
      "run": "",
      "when": ""
    }
  },
  "closing": {
    "maxProductionFiles": 0,
    "full": [
      {"name": "authorisation", "path": "(?i)(authori[sz]|permission|polic(y|ies)\b|securit|claims?\b|access(control|provider|rule|right)|grant)", "changes": "AMD"},
      {"name": "migration", "path": "(?i)(^|/)migrations?/", "changes": "AMD"},
      {"name": "public contract", "path": "(?i)(^|/)(api|contracts?|openapi)/", "changes": "MD"}
    ]
  },
  "tdd": {
    "failedTest": "^\\s*(?:(?:failed|Failed|FAILED|FAIL|\\[FAIL\\]|✗|×)\\s+|---- (?=\\S+ stdout ----))(\\S+)",
    "setupFailure": "\\b(?:Class|Collection|Assembly) fixture type\\b|\\bthrew in (?:InitializeAsync|DisposeAsync)\\b|\\bTest Class Cleanup Failure\\b|\\benvironment variables?\\b|\\b(?:beforeAll|BeforeAll|BeforeClass|setUpClass|setup_class)\\b|\\bfixture '[^']+' not found\\b",
    "summaryFailed": "(?:^|[\\s,])[Ff]ailed:\\s*(\\d+)|\\b(\\d+) failed\\b",
    "summaryTotal": "(?:^|[\\s,])[Tt]otal:\\s*(\\d+)|\\b(\\d+) total\\b",
    "stubFailure": "NotImplemented(?:Exception|Error)|UnsupportedOperationException|[Nn]ot implemented|not yet implemented",
    "stubLogic": "^\\s*(?:if|elif|else|switch|case|match|for|foreach|while|loop|catch|except)\\b",
    "assertion": "\\b(Assert\\.|assert\\w*\\b|Should(\\(|\\.)|should\\w*\\(|expect\\(|verify\\w*\\(|Verify(Async)?\\(|\\.Received\\(|pytest\\.raises)"
  }
}
