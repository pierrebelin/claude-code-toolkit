{
  "description": "One project per layer: src/<Product>.<Layer>/ and tests/<Product>.<Suite>/, one handler folder per use case. The kit's original shape.",
  "layout": {
    "sources": {
      "roots": ["src"],
      "extensions": [".cs"],
      "comment": "//",
      "imports": "^\\s*(?:global\\s+)?using\\s+(?:static\\s+)?[\\w.]+(?:\\s*=\\s*[\\w.<>, ]+)?\\s*;\\s*$"
    },
    "aggregate": [
      "*/*.Domain/*/Aggregates/*.cs",
      "*/*.Domain/*/ValueObjects/*.cs"
    ],
    "useCase": {
      "roots": ["src/{product}.Application"],
      "contextDepth": 1,
      "label": "Application/",
      "marker": [
        {"file": "*Handler.cs", "contains": "^\\s*(?:public|internal)\\s+(?:sealed\\s+|abstract\\s+|partial\\s+)*class\\s+\\w*Handler\\b"}
      ]
    },
    "ruleSheet": "CLAUDE.md",
    "tests": {
      "roots": ["tests"],
      "bound": ["tests/{product}.UnitTests"],
      "interaction": ["tests/*.UnitTests", "tests/*.CoreTests"],
      "shared": ["tests/*.CoreTests"]
    },
    "skipDirs": ["bin", "obj", "bin-linux", "obj-linux", "Properties"]
  },
  "testTag": {
    "framework": "xunit"
  },
  "commands": {
    "build": "rtk dotnet build {product}.sln --no-restore",
    "test": "rtk dotnet test --project tests/{product}.{suite}/{product}.{suite}.csproj --no-build --no-restore",
    "testFast": "rtk dotnet build tests/{product}.{suite}/{product}.{suite}.csproj --no-restore && dotnet tests/{product}.{suite}/bin/Debug/net*/{product}.{suite}.dll",
    "worktreeSetup": "rtk dotnet restore {product}.sln",
    "architectureTest": {
      "run": "rtk dotnet test --project tests/{product}.ArchitectureTests/{product}.ArchitectureTests.csproj --no-build --no-restore",
      "when": "^src/.*(Handler|Endpoints/|Repositories/|Extensions/|DbContext)"
    },
    "suites": [
      {"name": "UnitTests"},
      {"name": "ArchitectureTests", "when": "^src/.*(Handler|Endpoints/|Repositories/|Extensions/|DbContext)"},
      {"name": "ContractTests", "when": "^src/[^/]*\\.(Api|Abstractions)[^/]*/|Endpoints/"},
      {"name": "IntegrationTests", "when": "^src/[^/]*\\.Infrastructure/", "filter": "--filter-class \"*.{namespace}.*\"", "project": "tests/{product}.IntegrationTests"}
    ]
  },
  "closing": {
    "maxProductionFiles": 12,
    "full": [
      {"name": "authorisation", "path": "(?i)(authori[sz]|permission|polic(y|ies)\\b|securit|claims?\\b|access(control|provider|rule|right)|grant)", "changes": "AMD"},
      {"name": "migration", "path": "(?i)(^|/)migrations?/", "changes": "AMD"},
      {"name": "public contract", "path": "^src/[^/]*\\.Abstractions[^/]*/", "changes": "MD"},
      {"name": "approved snapshot", "path": "\\.verified\\.[^/]+$", "changes": "MD", "scope": "all"}
    ]
  },
  "tdd": {
    "failedTest": "^\\s*(?:failed|Failed|FAILED|\\[FAIL\\]|✗|×)\\s+(\\S+)",
    "stubFailure": "NotImplementedException",
    "stubLogic": "^\\s*(?:if|else|switch|case|for|foreach|while|catch)\\b|\\?\\?",
    "assertion": "\\b(Assert\\.|Should(\\(|\\.)|Verify(Async)?\\(|\\.Received\\()"
  }
}
