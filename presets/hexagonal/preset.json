{
  "description": "Domain core, ports and adapters: src/domain/ (model), src/application/ (use cases behind driving ports), src/adapters/ (driven and driving adapters). Stack-neutral markers: C#, Python, Java/Kotlin, TypeScript.",
  "layout": {
    "sources": {
      "roots": [
        "src"
      ],
      "extensions": [
        ".cs",
        ".py",
        ".java",
        ".kt",
        ".ts",
        ".tsx",
        ".js"
      ],
      "comment": {
        ".cs": "//",
        ".py": "#",
        ".java": "//",
        ".kt": "//",
        ".ts": "//",
        ".tsx": "//",
        ".js": "//"
      },
      "imports": {
        ".cs": "^\\s*(?:global\\s+)?using\\s+(?:static\\s+)?[\\w.]+(?:\\s*=\\s*[\\w.<>, ]+)?\\s*;\\s*$",
        ".py": "^\\s*(?:import\\s+[\\w.]+|from\\s+[\\w.]+\\s+import\\s)",
        ".java": "^\\s*import\\s+(?:static\\s+)?[\\w.*]+\\s*;\\s*$",
        ".kt": "^\\s*import\\s+[\\w.*]+(?:\\s+as\\s+\\w+)?\\s*$",
        ".ts": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]",
        ".tsx": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]",
        ".js": "^\\s*import\\s.*\\bfrom\\s+['\"]|^\\s*import\\s+['\"]|^\\s*export\\s.*\\bfrom\\s+['\"]|^\\s*(?:const|let|var)\\s+[\\w{}\\s,]+=\\s*require\\("
      }
    },
    "aggregate": [
      "*/src/domain/*",
      "*/src/Domain/*",
      "*/src/*/domain/*",
      "*/src/*/Domain/*"
    ],
    "useCase": {
      "roots": [
        "src/application",
        "src/Application",
        "src/{product}/application",
        "src/{product}/Application"
      ],
      "contextDepth": 1,
      "label": "application/",
      "marker": [
        {
          "file": "*UseCase.cs",
          "contains": "\\bclass\\s+\\w*UseCase\\b"
        },
        {
          "file": "*Handler.cs",
          "contains": "\\bclass\\s+\\w*Handler\\b"
        },
        {
          "file": "*use_case.py",
          "contains": "^\\s*(?:async\\s+)?def\\s+(?:execute|handle)\\b|^class\\s+\\w*UseCase\\b"
        },
        {
          "file": "*UseCase.java",
          "contains": "\\bclass\\s+\\w*UseCase\\b"
        },
        {
          "file": "*UseCase.kt",
          "contains": "\\bclass\\s+\\w*UseCase\\b"
        },
        {
          "file": "*[uU]se[cC]ase.ts",
          "contains": "\\bclass\\s+\\w*UseCase\\b|\\bfunction\\s+\\w+\\b"
        }
      ]
    },
    "ruleSheet": "CLAUDE.md",
    "tests": {
      "roots": [
        "tests",
        "test",
        "src/test"
      ],
      "bound": [
        "tests/unit",
        "test/unit",
        "src/test"
      ],
      "interaction": [
        "tests/unit",
        "test/unit",
        "src/test"
      ]
    },
    "skipDirs": [
      "bin",
      "obj",
      "node_modules",
      "__pycache__",
      ".venv",
      "venv",
      "dist",
      "build",
      "target",
      ".pytest_cache"
    ]
  },
  "testTag": {
    "framework": "xunit"
  },
  "commands": {
    "build": "",
    "test": "",
    "worktreeSetup": "",
    "architectureTest": {
      "run": "",
      "when": ""
    }
  },
  "closing": {
    "maxProductionFiles": 12,
    "full": [
      {"name": "authorisation", "path": "(?i)(authori[sz]|permission|polic(y|ies)\b|securit|claims?\b|access(control|provider|rule|right)|grant)", "changes": "AMD"},
      {"name": "migration", "path": "(?i)(^|/)migrations?/", "changes": "AMD"},
      {"name": "public contract", "path": "(?i)(^|/)(api|contracts?|openapi)/", "changes": "MD"}
    ]
  },
  "tdd": {
    "failedTest": "^\\s*(?:failed|Failed|FAILED|FAIL|\\[FAIL\\]|✗|×)\\s+(\\S+)",
    "stubFailure": "NotImplemented(?:Exception|Error)|UnsupportedOperationException|[Nn]ot implemented",
    "stubLogic": "^\\s*(?:if|elif|else|switch|case|match|for|foreach|while|catch|except)\\b"
  }
}
