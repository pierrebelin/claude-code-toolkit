{
  "cases": [
    {
      "name": "IntegrationTests whole suite is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "APP_TEST_MODE=true rtk dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore"}},
      "expect": {"decision": "deny", "reason": "Whole IntegrationTests suite refused"}
    },
    {
      "name": "IntegrationTests assembly run directly (commands.testFast) without a filter is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "rtk dotnet build tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-restore && APP_TEST_MODE=true dotnet tests/{{PRODUCT}}.IntegrationTests/bin/Debug/net10.0/{{PRODUCT}}.IntegrationTests.dll"}},
      "expect": {"decision": "deny", "reason": "Whole IntegrationTests suite refused"}
    },
    {
      "name": "IntegrationTests assembly run directly with --filter-class passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "rtk dotnet build tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-restore && APP_TEST_MODE=true dotnet tests/{{PRODUCT}}.IntegrationTests/bin/Debug/net10.0/{{PRODUCT}}.IntegrationTests.dll --filter-class \"*.Studio.Templates.Save.*\""}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "IntegrationTests redirected to a file, still whole, still denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "export SCRATCH=/tmp/x; APP_TEST_MODE=true dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore > \"$SCRATCH/test-IntegrationTests.txt\" 2>&1; echo \"exit=$?\"; tail -15 \"$SCRATCH/test-IntegrationTests.txt\""}},
      "expect": {"decision": "deny", "reason": "filter-class"}
    },
    {
      "name": "IntegrationTests whole under the run-plan final check marker passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "nohup sh -c 'KIT_FINAL_CHECK=1 APP_TEST_MODE=true dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore > /tmp/final-IntegrationTests.txt 2>&1; echo $? > /tmp/final-IntegrationTests.exit' >/dev/null 2>&1 &"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "IntegrationTests with --filter-class passes (rtk rewrite applies)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "APP_TEST_MODE=true dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore --filter-class \"*.Studio.Templates.Save.*\""}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "IntegrationTests with --filter-method passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "rtk dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore --filter-class \"*SaveTests\" --filter-method \"ShouldSave*\""}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "UnitTests whole suite passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "dotnet test --project tests/{{PRODUCT}}.UnitTests/{{PRODUCT}}.UnitTests.csproj --no-build --no-restore"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "dotnet build naming IntegrationTests passes (not a test run)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "dotnet build tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-restore"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "subagent is denied too",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "agent_id": "agent-abc", "tool_input": {"command": "APP_TEST_MODE=true rtk dotnet test --project tests/{{PRODUCT}}.IntegrationTests/{{PRODUCT}}.IntegrationTests.csproj --no-build --no-restore"}},
      "expect": {"decision": "deny", "reason": "Whole IntegrationTests suite"}
    }
  ]
}
