{
  "fixtures": [
    {"path": "big.cs", "lines": 300},
    {"path": "huge.cs", "lines": 500},
    {"path": "small.cs", "lines": 50},
    {"path": "heavy.md", "lines": 119, "kind": "md"},
    {"path": "rules/big-rule.md", "lines": 300, "kind": "md"},
    {"path": "kb/.claude/kit.config.json", "kind": "text", "content": "{\"knowledge\": {\"contexts\": {\"Catalog\": \"CAT\"}}}"},
    {"path": "kb/docs/business/Catalog/rules.md", "kind": "text", "content": "# Catalog — cross-cutting rules\n\n### CAT-RM-001 — A product is visible only to its organisation\n"},
    {"path": "kb/docs/business/Catalog/OVERVIEW.md", "kind": "text", "content": "# Catalog\n\nCatalog holds the products.\n"}
  ],
  "cases": [
    {
      "name": "bare cat of a big file is denied with the frozen literal",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded cat on"}
    },
    {
      "name": "cat denial names cctoolkit bulk-read as the third way out",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "cctoolkit bulk-read --question"}
    },
    {
      "name": "piped cat passes (the pipe bounds it)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs | grep C1"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "redirected cat passes (never enters the context)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs > /tmp/claude-evalout-{{SID}}"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "cat behind a cd is still a bare cat (Spotify's anchored regex misses this)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cd /tmp && cat {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded cat on"}
    },
    {
      "name": "cat of a small file passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/small.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "re-issuing the identical cat forces it through",
      "hook": "hooks/bash-dispatch.sh",
      "pre": [{"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs"}}],
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "instruction file passes the cat guard too (same skip list as Read)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/rules/big-rule.md"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "119-line markdown over 8 kB is denied on the byte bound",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/heavy.md"}},
      "expect": {"decision": "deny", "reason": "bytes"}
    },
    {
      "name": "sed -n range is a bounded read and passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "sed -n '1,40p' {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "head -20 on a big file is bounded by definition and passes (Spotify's hook blocks it)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -20 {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "head -n 5000 on a big file is a dump in disguise and is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -n 5000 {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded head on"}
    },
    {
      "name": "head -200 (past the 120-line bound) is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -200 {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded head on"}
    },
    {
      "name": "tail -n +1 is the whole file and is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "tail -n +1 {{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded tail on"}
    },
    {
      "name": "tail -n +250 of a 300-line file is 51 lines and passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "tail -n +250 {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "tail -n 20 passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "tail -n 20 {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "head -c past the byte bound on a heavy markdown is denied",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -c 100000 {{FIX}}/heavy.md"}},
      "expect": {"decision": "deny", "reason": "Unbounded head on"}
    },
    {
      "name": "head -c within the byte bound passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -c 4000 {{FIX}}/heavy.md"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "head with no count is 10 lines and passes",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "piped head passes whatever the span",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -n 5000 {{FIX}}/big.cs | grep C1"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "a subagent cats a 300-line file whole: under the subagent bar of 400, as for Read",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "agent_id": "agent-a", "tool_input": {"command": "cat {{FIX}}/big.cs"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "a subagent is still denied a cat past 400 lines",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "agent_id": "agent-a", "tool_input": {"command": "cat {{FIX}}/huge.cs"}},
      "expect": {"decision": "deny", "reason": "> 400 lines"}
    },
    {
      "name": "knowledge base: a cat of a context's rules.md is denied whatever its size, pointing to cctoolkit ask",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "deny", "reason": "Whole cat of"}
    },
    {
      "name": "knowledge base: the cat denial names the context and a sed range",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "deny", "reason": "--history --context Catalog"}
    },
    {
      "name": "knowledge base: tail -n +1 of rules.md is a whole dump, denied",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "tool_input": {"command": "tail -n +1 {{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "deny", "reason": "Whole tail of"}
    },
    {
      "name": "knowledge base: head -1 of rules.md is a bounded read and passes",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "tool_input": {"command": "head -1 {{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "knowledge base: the same cat re-issued is forced through",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "pre": [{"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/rules.md"}}],
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "knowledge base: OVERVIEW.md is dumped whole",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/OVERVIEW.md"}},
      "expect": {"decision": "not_deny"}
    },
    {
      "name": "knowledge base: knowledge-extractor cats rules.md whole",
      "hook": "hooks/bash-dispatch.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Bash", "agent_id": "a1", "tool_input": {"command": "cat {{FIX}}/kb/docs/business/Catalog/rules.md"}, "agent_type": "cctoolkit:knowledge-extractor"},
      "expect": {"decision": "not_deny"}
    },
    {"name": "cat with stderr merged (2>&1) still dumps the file and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs 2>&1"}}, "expect": {"decision": "deny", "reason": "Unbounded cat on"}},
    {"name": "cat with stderr discarded (2>/dev/null) still dumps the file and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs 2>/dev/null"}}, "expect": {"decision": "deny", "reason": "Unbounded cat on"}},
    {"name": "cat sending both streams to a file (&>) never reaches the context and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs &> /tmp/claude-evalout-{{SID}}"}}, "expect": {"decision": "not_deny"}},
    {"name": "sed -n '1,9999p' is a dump in disguise and is denied, naming sed", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed -n '1,9999p' {{FIX}}/big.cs"}}, "expect": {"decision": "deny", "reason": "Unbounded sed on"}},
    {"name": "sed -n '1,$p' is the whole file and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed -n '1,$p' {{FIX}}/big.cs"}}, "expect": {"decision": "deny"}},
    {"name": "sed -n '250,$p' of a 300-line file is 51 lines and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed -n '250,$p' {{FIX}}/big.cs"}}, "expect": {"decision": "not_deny"}},
    {"name": "sed without -n prints the whole file and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed 's/C1/D1/' {{FIX}}/big.cs"}}, "expect": {"decision": "deny", "reason": "Unbounded sed on"}},
    {"name": "sed 20q is a head of 20 lines and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed 20q {{FIX}}/big.cs"}}, "expect": {"decision": "not_deny"}},
    {"name": "sed -i edits in place, prints nothing, and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed -i 's/C1/D1/' {{FIX}}/big.cs"}}, "expect": {"decision": "not_deny"}},
    {"name": "sed -n with a pattern filters and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "sed -n '/C1/p' {{FIX}}/big.cs"}}, "expect": {"decision": "not_deny"}},
    {"name": "awk 1 is a cat and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "awk 1 {{FIX}}/big.cs"}}, "expect": {"decision": "deny", "reason": "Unbounded awk on"}},
    {"name": "awk '{print $0}' is a cat and is denied", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "awk '{print $0}' {{FIX}}/big.cs"}}, "expect": {"decision": "deny"}},
    {"name": "awk with a condition filters and passes", "hook": "hooks/bash-dispatch.sh", "input": {"tool_name": "Bash", "tool_input": {"command": "awk '/C1/' {{FIX}}/big.cs"}}, "expect": {"decision": "not_deny"}}
  ]
}
