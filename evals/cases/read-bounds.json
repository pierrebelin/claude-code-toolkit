{
  "fixtures": [
    {"path": "big.cs", "lines": 300},
    {"path": "huge.cs", "lines": 500},
    {"path": "small.cs", "lines": 50},
    {"path": "flat.cs", "lines": 200, "kind": "flat"},
    {"path": "heavy.md", "lines": 119, "kind": "md"},
    {"path": "rules/big-rule.md", "lines": 300, "kind": "md"},
    {"path": "img.png", "lines": 300},
    {"path": "kb/.claude/kit.config.json", "kind": "text", "content": "{\"knowledge\": {\"contexts\": {\"Catalog\": \"CAT\"}}}"},
    {"path": "kb/docs/business/Catalog/rules.md", "kind": "text", "content": "# Catalog — cross-cutting rules\n\n### CAT-RM-001 — A product is visible only to its organisation\n"},
    {"path": "kb/docs/business/Catalog/HISTORY.md", "kind": "text", "content": "# Catalog — history\n"},
    {"path": "kb/docs/business/Catalog/OVERVIEW.md", "kind": "text", "content": "# Catalog\n\nCatalog holds the products.\n"},
    {"path": "kb/notes/rules.md", "kind": "text", "content": "# Notes\n"}
  ],
  "cases": [
    {
      "name": "bounded read of a big file passes",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs", "offset": 10, "limit": 40}},
      "expect": {"decision": "none"}
    },
    {
      "name": "unbounded read of a small file passes",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/small.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "unbounded read of a big file is denied with the frozen literal",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "Unbounded Read on"}
    },
    {
      "name": "denial names cctoolkit bulk-read as the third way out",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "cctoolkit bulk-read --question"}
    },
    {
      "name": "re-issuing the identical read forces it through",
      "hook": "hooks/read-bounds.sh",
      "pre": [{"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs"}}],
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "a forcing by one agent does not exempt another agent of the same session",
      "hook": "hooks/read-bounds.sh",
      "pre": [
        {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/huge.cs"}},
        {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/huge.cs"}}
      ],
      "input": {"tool_name": "Read", "agent_id": "agent-b", "tool_input": {"file_path": "{{FIX}}/huge.cs"}},
      "expect": {"decision": "deny"}
    },
    {
      "name": "a forcing by a subagent does not exempt the main chain",
      "hook": "hooks/read-bounds.sh",
      "pre": [
        {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/huge.cs"}},
        {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/huge.cs"}}
      ],
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/huge.cs"}},
      "expect": {"decision": "deny"}
    },
    {
      "name": "a subagent reads a 300-line file whole: under the subagent bar of 400",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/big.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "a subagent is still denied past 400 lines",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "agent_id": "agent-a", "tool_input": {"file_path": "{{FIX}}/huge.cs"}},
      "expect": {"decision": "deny", "reason": "> 400 lines"}
    },
    {
      "name": "the main chain keeps the 120-line bar on the same 300-line file",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/big.cs"}},
      "expect": {"decision": "deny", "reason": "> 120 lines"}
    },
    {
      "name": "instruction file is read whole or not at all",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/rules/big-rule.md"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "binary formats are left to the tool",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/img.png"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "flat file past the threshold passes (outline would cost more than it saves)",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/flat.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "119-line markdown over 8 kB is denied on the byte bound (was a Read/cat divergence)",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/heavy.md"}},
      "expect": {"decision": "deny", "reason": "bytes"}
    },
    {
      "name": "another tool's payload is ignored",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cat {{FIX}}/big.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "missing file is left to the tool's own error",
      "hook": "hooks/read-bounds.sh",
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/does-not-exist.cs"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "knowledge base: a whole Read of a context's rules.md is denied whatever its size, pointing to cctoolkit ask",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "deny", "reason": "read through cctoolkit ask, whatever their size"}
    },
    {
      "name": "knowledge base: the denial names the context in the ask commands",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/HISTORY.md"}},
      "expect": {"decision": "deny", "reason": "--history --context Catalog"}
    },
    {
      "name": "knowledge base: the same Read re-issued is forced through",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "pre": [{"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/rules.md"}}],
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/rules.md"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "knowledge base: a bounded Read of rules.md passes",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/rules.md", "offset": 3, "limit": 5}},
      "expect": {"decision": "none"}
    },
    {
      "name": "knowledge base: OVERVIEW.md is read whole",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/OVERVIEW.md"}},
      "expect": {"decision": "none"}
    },
    {
      "name": "knowledge base: knowledge-extractor reads rules.md whole, it rewrites it in its staging",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "agent_id": "a1", "tool_input": {"file_path": "{{FIX}}/kb/docs/business/Catalog/rules.md"}, "agent_type": "cctoolkit:knowledge-extractor"},
      "expect": {"decision": "none"}
    },
    {
      "name": "knowledge base: a rules.md outside the base is an ordinary file",
      "hook": "hooks/read-bounds.sh",
      "env": {"CLAUDE_PROJECT_DIR": "{{FIX}}/kb"},
      "input": {"tool_name": "Read", "tool_input": {"file_path": "{{FIX}}/kb/notes/rules.md"}},
      "expect": {"decision": "none"}
    }
  ]
}
