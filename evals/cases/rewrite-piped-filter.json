{
  "cases": [
    {
      "name": "a bare graphify query is piped through graphify-query-filter.sh",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "graphify query \"Product\""}},
      "expect": {"decision": "allow", "reason": "graphify query filter", "command": "graphify query \"Product\" | bash "}
    },
    {
      "name": "git grep as the last segment behind `cd x &&` is piped through git-grep-filter.sh",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "cd src && git grep -n foo"}},
      "expect": {"decision": "allow", "reason": "git grep filter", "command": "git-grep-filter.sh"}
    },
    {
      "name": "a graphify query on the last line of a multi-line command is piped (the match is per line)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "echo start\ngraphify query \"x\""}},
      "expect": {"decision": "allow", "command": "graphify-query-filter.sh"}
    },
    {
      "name": "git grep followed by another segment is not the last segment: untouched",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "git grep -n foo && echo done"}},
      "expect": {"command_absent": "git-grep-filter.sh"}
    },
    {
      "name": "an already piped graphify query is left alone (the escape hatch)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "graphify query \"x\" | cat"}},
      "expect": {"command_absent": "graphify-query-filter.sh"}
    },
    {
      "name": "a command already carrying the filter is not filtered twice",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "echo graphify-query-filter.sh; graphify query \"x\" "}},
      "expect": {"command_absent": "| bash"}
    },
    {
      "name": "graphify explain has no filter",
      "hook": "hooks/bash-dispatch.sh",
      "input": {"tool_name": "Bash", "tool_input": {"command": "graphify explain \"Product\""}},
      "expect": {"command_absent": "filter.sh"}
    },
    {
      "name": "module alone: graphify query then git grep on two lines, graphify wins",
      "cmd": "HOOK_INPUT='{}' HOOK_CMD=$'git grep -n x\\ngraphify query y' bash {{KIT}}/lib/rewrite-piped-filter.sh",
      "expect": {"exit": 0, "stdout": "graphify-query-filter.sh"}
    },
    {
      "name": "module alone: no payload, no answer",
      "cmd": "out=$(HOOK_CMD='graphify query y' bash {{KIT}}/lib/rewrite-piped-filter.sh); echo \"rc=$? [$out]\"",
      "expect": {"exit": 0, "stdout": "rc=0 []"}
    }
  ]
}
