{
  "fixtures": [
    { "path": "a/questions/F1-1.json", "kind": "text", "content": "{\"batch\":\"F1\",\"sheet\":\"x\",\"kind\":\"stop\",\"context\":\"x\",\"questions\":[{\"id\":\"q1\",\"severity\":\"Bloquant\",\"question\":\"x ?\",\"evidence\":\"x\",\"options\":[],\"recommendation\":\"\"}]}" },
    { "path": "a/questions/F1-1.answer.json", "kind": "text", "content": "{\"answers\":[{\"id\":\"q1\",\"text\":\"réponse d un run précédent\"}]}" },
    { "path": "b/questions/F1-1.json", "kind": "text", "content": "{\"batch\":\"F1\",\"sheet\":\"x\",\"kind\":\"stop\",\"context\":\"x\",\"questions\":[{\"id\":\"q1\",\"severity\":\"Bloquant\",\"question\":\"x ?\",\"evidence\":\"x\",\"options\":[],\"recommendation\":\"\"}]}" },
    { "path": "c/questions/F1-1.json", "kind": "text", "content": "{\"batch\":\"F1\",\"sheet\":\"x\",\"kind\":\"stop\",\"context\":\"x\",\"questions\":[{\"id\":\"q1\",\"severity\":\"Bloquant\",\"question\":\"x ?\",\"evidence\":\"x\",\"options\":[],\"recommendation\":\"\"}]}" },
    { "path": "c/questions/F1-1.answer.json", "kind": "text", "content": "{\"answers\":[{\"id\":\"q1\",\"text\":\"réponse d un run précédent\"}]}" },
    { "path": "d/run/.work/F1/questions/F1-1.json", "kind": "text", "content": "{\"batch\":\"F1\",\"sheet\":\"x\",\"kind\":\"stop\",\"context\":\"x\",\"questions\":[{\"id\":\"q1\",\"severity\":\"Bloquant\",\"question\":\"x ?\",\"evidence\":\"x\",\"options\":[],\"recommendation\":\"\"}]}" }
  ],
  "cases": [
    { "name": "an answer older than its question is a leftover of an earlier run: wait ignores it",
      "cmd": "touch -t 202001010000 {{FIX}}/a/questions/F1-1.answer.json && python3 {{KIT}}/scripts/run-question.py wait {{FIX}}/a/questions/F1-1.json --seconds 1",
      "expect": { "exit": 3, "stdout": "PENDING" } },
    { "name": "the same leftover keeps the question visible to watch, with the since to re-arm",
      "cmd": "python3 {{KIT}}/scripts/run-question.py watch {{FIX}}/a --since 0 --seconds 3",
      "expect": { "exit": 0, "stdout": "next=" } },
    { "name": "answer accepts the object wait prints, then wait returns it",
      "cmd": "python3 {{KIT}}/scripts/run-question.py answer {{FIX}}/b/questions/F1-1.json '{\"answers\": [{\"id\": \"q1\", \"text\": \"oui\"}]}' >/dev/null && python3 {{KIT}}/scripts/run-question.py wait {{FIX}}/b/questions/F1-1.json --seconds 1",
      "expect": { "exit": 0, "stdout": "oui" } },
    { "name": "an answer written after its question is returned",
      "cmd": "touch {{FIX}}/c/questions/F1-1.answer.json && python3 {{KIT}}/scripts/run-question.py wait {{FIX}}/c/questions/F1-1.json --seconds 1",
      "expect": { "exit": 0, "stdout": "run précédent" } },
    { "name": "watch walks the hidden scratch folder of the run",
      "cmd": "python3 {{KIT}}/scripts/run-question.py watch {{FIX}}/d/run --since 0 --seconds 3",
      "expect": { "exit": 0, "stdout": ".work/F1/questions/F1-1.json" } }
  ]
}
